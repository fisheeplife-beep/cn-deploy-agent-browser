# Optional env for agent-browser (copy to .env and source if you like)
# Docs: https://agent-browser.dev / upstream README

# Prefer a system Chrome/Chromium when Chrome-for-Testing download is blocked in CN:
# AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
# AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# HTTP(S) proxy for CLI + Chromium (helps when Google CDN is blocked)
# AGENT_BROWSER_PROXY=http://127.0.0.1:7890
# AGENT_BROWSER_PROXY_BYPASS=localhost,127.0.0.1,<<local>>

# Persist session state across restarts
# AGENT_BROWSER_SESSION=work
# AGENT_BROWSER_RESTORE=1

# Encrypt saved state at rest (64 hex chars): openssl rand -hex 32
# AGENT_BROWSER_ENCRYPTION_KEY=

# Optional AI chat via Vercel AI Gateway
# AI_GATEWAY_API_KEY=gw_...
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6

# Headed / display (Linux servers usually stay headless)
# AGENT_BROWSER_HEADED=1
# AGENT_BROWSER_NO_XVFB=1

# Safety for agents
# AGENT_BROWSER_ALLOWED_DOMAINS=example.com,*.example.com
# AGENT_BROWSER_CONTENT_BOUNDARIES=1
# AGENT_BROWSER_MAX_OUTPUT=50000
